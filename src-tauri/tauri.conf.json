{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PapaPlay",
  "version": "0.1.0",
  "identifier": "com.papaplay.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "PapaPlay",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "visible": true
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "PapaPlay Overlay",
        "width": 1280,
        "height": 720,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/dict.db": "dict.db",
      "resources/models/en_dict.txt": "models/en_dict.txt",
      "resources/models/en_PP-OCRv3_det_infer.onnx": "models/en_PP-OCRv3_det_infer.onnx",
      "resources/models/en_PP-OCRv3_rec_infer.onnx": "models/en_PP-OCRv3_rec_infer.onnx",
      "resources/nmt/meta.json": "nmt/meta.json",
      "resources/nmt/tokenizer.json": "nmt/tokenizer.json"
    }
  }
}
