# deps / build
node_modules/
dist/
target/
*.local

# tauri
src-tauri/gen/

# db e mídia locais de teste
*.db
media/

# O dict.db (~42 MB) é artefato de build, como os modelos de OCR: sai inteiro de
# `pnpm run build:dict`. Fora do git porque binário grande no histórico só sai
# reescrevendo histórico depois.
# dumps do wiktextract/wordfreq: ~500 MB, também refeitos pelo mesmo comando
scripts/.cache/

# capturas de tela avulsas das validações manuais (ficam só na máquina)
imagens/

# modelos de OCR: 11 MB de binário, refeitos por scripts/fetch-ocr-models.ps1
src-tauri/resources/models/

# Modelos de tradução: os dois .onnx são ~330 MB, refeitos por
# scripts/export-nmt.ps1 e baixados pelo app no setup (src-tauri/src/setup.rs).
#
# O meta.json e o tokenizer.json ficam **no git**: eles vão dentro do
# instalador, e o build não pode depender de rodar um export de 330 MB em Python
# para conseguir 3,7 MB de tokenizador. São o contrato entre o app e o modelo, e
# versioná-los junto do código é o que impede "app novo, tokenizador velho".
#
# Ignora o conteúdo, e não a pasta: o git não readmite um arquivo cujo diretório
# pai está excluído.
src-tauri/resources/nmt/*
!src-tauri/resources/nmt/meta.json
!src-tauri/resources/nmt/tokenizer.json

# saída visual do `ocr-spike --desenhar`, regerável a partir da fixture
*.boxes.png

# saída do `capture-probe`: é um retrato da tela do usuário, nunca vai ao repo
capture-probe*.png

# editor/os
.vscode/
.idea/
Thumbs.db
.DS_Store

# env
.env*
